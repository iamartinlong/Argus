# Go
build/
data/
*.exe
*.test
coverage.out

# SQLite 运行库（含加密凭据，绝不入库）
*.db
*.db-shm
*.db-wal

# Node / web
web/node_modules/
web/dist/
web/*.tsbuildinfo
web/.env

# 前端构建产物（webassets/dist 由 web npm run build 产出并 go:embed 内嵌）
# 仅放行 .gitkeep 占位：保证未构建前端时 go build/vet/test 也能编译
webassets/dist/*
!webassets/dist/.gitkeep

# site-docs
site-docs/node_modules/
site-docs/docs/.vitepress/cache/
site-docs/docs/.vitepress/dist/
*.log

# IDE
.idea/
.vscode/
*.swp

# OS
Thumbs.db
.DS_Store

# 密钥与敏感文件
*.key
!internal/infrastructure/crypto/*.go
config.local.yaml
.env

